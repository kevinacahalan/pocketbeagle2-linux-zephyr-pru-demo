# Checked in
#   README.md, LAYOUT.md, PINMUX.md, LICENSE, .gitignore
#   zephyr/west.yml                   west manifest (workspace topdir is the repo root)
#   linux-app/                        Linux userspace program (pb2)
#   beagle-linux/                     Debian overlays, patched pru_rproc, scripts
#   containers/                       Linux, TI CGT, and Zephyr SDK images
#   zephyr/                           M4 app and shared mailbox header
#   pru/pru0/ pru/pru1/               one folder per PRU core (not pru/build/)
#   yocto/                            kas, layers, and config only
#
# Temporary. These stay on disk and stay untracked.

# West workspace created by `west init -l zephyr` from the repo root.
# zephyr/upstream is the upstream checkout. The demo files in zephyr/ stay tracked.
.west/
/zephyr/upstream/
modules/
bootloader/
tools/
build/

# Fetched tools and sources. Not vendored.
third_party/
.cache/

# Yocto kas-container tree. Kas files and meta-pb2 stay tracked.
yocto/sources/
yocto/downloads/
yocto/build/
yocto/sstate-cache/

