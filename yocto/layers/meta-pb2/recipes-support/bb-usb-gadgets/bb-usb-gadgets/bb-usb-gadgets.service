[Unit]
Description=BeagleBoard.org USB gadgets
After=sys-kernel-config.mount usb-gadget.target
Requires=sys-kernel-config.mount
ConditionFileIsExecutable=/usr/bin/bb-start-usb-gadgets

[Service]
# The Beagle script does not fork. systemd 259 treats a forking unit
# with no remaining main process as stopped, which drops the ACM getty
# start. Stay active after the configfs gadget is bound.
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/modprobe libcomposite
ExecStart=/usr/bin/bb-start-usb-gadgets

[Install]
WantedBy=multi-user.target
